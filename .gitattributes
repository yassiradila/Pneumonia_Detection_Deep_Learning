# Auto-detect text files and normalize line endings
* text=auto

# Source code and scripts
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.cff text eol=lf
*.sh text eol=lf

# Jupyter Notebooks
*.ipynb text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.keras binary
*.h5 binary
